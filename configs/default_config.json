{
  "version": "1.0.0",
  "pipeline_name": "Outdoor 3D Map Headless Pipeline",
  "input_search_dirs": ["Maps", "input", "."],
  "output_base_dir": "output",
  "reports_dir": "reports",
  "default_quality": "medium",
  "cleanup": {
    "remove_degenerate_faces": true,
    "remove_duplicate_vertices": true,
    "remove_isolated_components": true,
    "min_component_faces": 50,
    "min_component_ratio": 0.005,
    "remove_camera_gizmos": true,
    "rebuild_normals": true,
    "unify_winding": true
  },
  "optimization": {
    "high": {
      "render_ratio": 0.75,
      "collision_ratio": 0.15,
      "max_render_faces": 300000,
      "max_collision_faces": 8000
    },
    "medium": {
      "render_ratio": 0.45,
      "collision_ratio": 0.08,
      "max_render_faces": 150000,
      "max_collision_faces": 4000
    },
    "low": {
      "render_ratio": 0.20,
      "collision_ratio": 0.03,
      "max_render_faces": 50000,
      "max_collision_faces": 1500
    }
  },
  "segmentation": {
    "walkable_max_slope_deg": 38.0,
    "ground_height_quantile": 0.35,
    "min_cluster_faces": 40,
    "use_ai": false
  },
  "collision": {
    "method": "simplified_mesh_and_hulls",
    "convex_hulls_max": 24,
    "target_faces": 3000
  },
  "navigation": {
    "enabled": true,
    "slope_threshold_deg": 38.0,
    "min_walkable_area_ratio": 0.01,
    "nav_graph_sample_points": 500,
    "nav_graph_connect_radius": 0.08
  },
  "viewer": {
    "host": "127.0.0.1",
    "port": 8080
  }
}
